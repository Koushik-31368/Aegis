# Aegis Environment Variables (example)
# Copy to .env and fill in values

# Spring Boot services
EDGE_GATEWAY_PORT=8080
CLOUD_AGGREGATOR_PORT=8081

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Database (H2 for local dev, PostgreSQL/TimescaleDB for production)
DB_URL=jdbc:h2:mem:aegis;DB_CLOSE_DELAY=-1;MODE=PostgreSQL;NON_KEYWORDS=VALUE
DB_USERNAME=aegis
DB_PASSWORD=aegis_dev

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
